# frontend/.env.development

# 1️⃣ Tell CRA to use HTTPS
HTTPS=false

# 2️⃣ Point it at the mkcert‑generated certs in your backend/certs folder
SSL_CRT_FILE=../backend/ssl/cert.pem
SSL_KEY_FILE=../backend/ssl/key.pem

# 3️⃣ Make sure your React code hits the HTTPS API
REACT_APP_API_URL=http://localhost:4001

